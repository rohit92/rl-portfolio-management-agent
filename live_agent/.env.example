# =============================================================================
# Alpaca PAPER trading credentials
# =============================================================================
# 1. Make a free account at https://alpaca.markets
# 2. In the dashboard, switch to "Paper Trading" (top-left toggle).
# 3. Generate API keys (View / Regenerate) and paste them below.
# 4. Copy this file to ".env":   cp .env.example .env
#
# These keys are for PAPER trading (fake money). The base URL below points at
# the paper endpoint on purpose. Do NOT put live keys here until you have
# proven the strategy on paper.
# =============================================================================

ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Paper endpoint. Changing this to the live endpoint is the ONLY thing that
# moves real money — leave it as-is.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# =============================================================================
# Zerodha Kite Connect — REAL India data (NSE/BSE/NFO/MCX) — READ-ONLY here
# =============================================================================
# Gives the India desk real quotes, live F&O + MCX futures boards, and genuine
# option chains (real strikes/LTP/OI). This app uses it for DATA ONLY — it has
# no order-placement code.
#
#   1. Kite Connect is a PAID API (~₹2000/mo). Subscribe + create an app at
#      https://developers.kite.trade  (any http(s) redirect URL works; the
#      dashboard has you paste the request_token back manually).
#   2. Put the app's API key + secret below and `cp .env.example .env`.
#   3. In the dashboard → India desk → Broker card: click the login link, log in
#      on Zerodha's own site, paste the request_token from the redirect URL.
#   4. The access token expires ~6 AM IST daily — re-login each morning. Normal.
#
# Your Zerodha PASSWORD is never entered here or seen by this app — only the
# short-lived request_token from Zerodha's redirect.
KITE_API_KEY=
KITE_API_SECRET=

# =============================================================================
# Signal notifications (optional) — get trade signals on your phone
# =============================================================================
# Telegram (free, easiest):
#   1. Message @BotFather, /newbot, copy the token below.
#   2. Message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (free for personal use via CallMeBot):
#   Follow https://www.callmebot.com/blog/free-api-whatsapp-messages/ to get an
#   API key for your own number, then fill both below (phone in +<country><num>).
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=
