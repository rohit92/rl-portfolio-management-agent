<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly universe refresh + full re-scan (Crypto + Indian market) at 02:00.

  Install:
    cp com.rohitraj.scan.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.rohitraj.scan.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.rohitraj.scan.plist

  Note: scanning all ~2,300 NSE names can take a while; it runs overnight and is
  fault-tolerant (failed symbols are skipped). The Mac must be awake at 02:00.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rohitraj.scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/rohitraj/rl-trading-agent/live_agent/run_scan.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/rohitraj/rl-trading-agent/live_agent/state/scan.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/rohitraj/rl-trading-agent/live_agent/state/scan.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
