# Secrets — never commit real keys (Alpaca, Telegram, CallMeBot, etc.)
.env
**/.env
*.env
!*.env.example

# Node deps (tradingview-mcp)
node_modules/
**/node_modules/

# launchd job definitions may embed local absolute paths
live_agent/backtest_results/
live_agent/state/

# Data files (downloaded at runtime)
data/raw/*.csv
data/scaler_stats.json

# Model checkpoints
checkpoints/

# Results (generated by evaluate.py)
results/

# TensorBoard logs
runs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env_py/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Independent nested git repo (third-party MCP server, own history) — not tracked here
/tradingview-mcp
